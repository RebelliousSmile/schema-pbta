{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case identifier of the corporation."
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Folder slug of the game this corporation belongs to."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name of the card."
    },
    "description": {
      "description": "Prose describing the card.",
      "type": "string",
      "minLength": 1
    },
    "expertise": {
      "description": "Areas of expertise of the corporation.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "customMoves": {
      "description": "Custom moves of the corporation.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hoursMarked": {
      "description": "Number of segments of the six-segment hour track currently marked.",
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    }
  },
  "required": [
    "slug",
    "game",
    "name"
  ],
  "additionalProperties": false,
  "title": "The Sprawl corporation",
  "description": "Portable representation of a The Sprawl corporation card.",
  "$id": "https://raw.githubusercontent.com/RebelliousSmile/schema-pbta/v13.0.0/schemas/v13/the-sprawl/the-sprawl-corporation.schema.json"
}