{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case identifier of the front."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable front name."
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Folder slug of the game this front belongs to."
    },
    "concept": {
      "type": "string",
      "minLength": 1,
      "description": "Short concept summarizing the front."
    },
    "description": {
      "description": "Plain-text explanation of the front.",
      "type": "string",
      "minLength": 1
    },
    "stakes": {
      "description": "Open questions the front puts to the table.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cast": {
      "description": "People involved in the front.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable cast member name."
          },
          "role": {
            "description": "Role played by this cast member in the front.",
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "description": "Optional slug of an NPC file in the same game.",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "One member of the front's cast."
      }
    },
    "threats": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable threat name."
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Key of a threat type declared by the game."
          },
          "impulse": {
            "type": "string",
            "minLength": 1,
            "description": "Key of an impulse declared by the game."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Plain-text explanation of the threat."
          },
          "moves": {
            "description": "Moves available to this threat.",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                      "description": "Slug of a standalone move in the same game."
                    }
                  },
                  "required": [
                    "ref"
                  ],
                  "additionalProperties": false,
                  "description": "Reference to a standalone move."
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Human-readable move name."
                    },
                    "moveType": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Key declared in the game's move type vocabulary."
                    },
                    "audience": {
                      "description": "Optional audience that owns this move; MC moves use `mc`.",
                      "type": "string",
                      "enum": [
                        "character",
                        "npc",
                        "mc"
                      ]
                    },
                    "playbook": {
                      "description": "Playbook slug when the move belongs to one.",
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Plain-text explanation of the move."
                    },
                    "trigger": {
                      "description": "Situation that triggers the move.",
                      "type": "string",
                      "minLength": 1
                    },
                    "roll": {
                      "description": "Optional roll configuration.",
                      "type": "object",
                      "properties": {
                        "rollType": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Game stat key, `formula`, or `none` describing how the move rolls."
                        },
                        "rollFormula": {
                          "description": "Explicit roll formula when rollType is `formula`.",
                          "type": "string",
                          "minLength": 1
                        },
                        "rollMod": {
                          "description": "Signed 32-bit modifier added to the roll.",
                          "type": "integer",
                          "minimum": -2147483648,
                          "maximum": 2147483647
                        }
                      },
                      "required": [
                        "rollType"
                      ],
                      "additionalProperties": false
                    },
                    "results": {
                      "description": "Outcome entries keyed by the game's roll result vocabulary.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Human-readable label for this result tier."
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Plain-text outcome for this result tier."
                          }
                        },
                        "required": [
                          "label",
                          "text"
                        ],
                        "additionalProperties": false,
                        "description": "One possible outcome of a move roll."
                      }
                    },
                    "uses": {
                      "description": "Available uses, stored as an unsigned 32-bit count.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "choices": {
                      "description": "Choice instructions attached to the move.",
                      "type": "string",
                      "minLength": 1
                    },
                    "tags": {
                      "description": "Free-form tags attached to the move.",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "name",
                    "moveType",
                    "description"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "A move reference or a complete inline move."
            }
          },
          "clock": {
            "description": "Optional countdown attached to the threat.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Human-readable label for the clock."
                  },
                  "preset": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Key of a clock preset declared by the game."
                  },
                  "filled": {
                    "description": "Number of filled segments as an unsigned 32-bit count.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  }
                },
                "required": [
                  "label",
                  "preset"
                ],
                "additionalProperties": false,
                "description": "A clock using a preset from the game definition."
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Human-readable label for the clock."
                  },
                  "segments": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Ordered non-empty labels of the clock segments."
                  },
                  "filled": {
                    "description": "Number of filled segments as an unsigned 32-bit count.",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647
                  }
                },
                "required": [
                  "label",
                  "segments"
                ],
                "additionalProperties": false,
                "description": "A clock whose segments are declared inline."
              }
            ]
          }
        },
        "required": [
          "name",
          "type",
          "impulse",
          "description"
        ],
        "additionalProperties": false,
        "description": "A threat advancing the front."
      },
      "description": "Non-empty list of threats driving the front."
    },
    "portents": {
      "description": "Ordered signs that the doom is approaching.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Event foreshadowing the front's progression."
          },
          "done": {
            "description": "Whether this portent has already occurred.",
            "type": "boolean"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "description": "One visible sign of the approaching doom."
      }
    },
    "doom": {
      "type": "string",
      "minLength": 1,
      "description": "What happens if nobody stops the front."
    }
  },
  "required": [
    "slug",
    "name",
    "game",
    "concept",
    "threats",
    "doom"
  ],
  "additionalProperties": false,
  "title": "PbtA front",
  "description": "Portable representation of a Powered by the Apocalypse front or mystery.",
  "$id": "https://raw.githubusercontent.com/RebelliousSmile/schema-pbta/v1/schemas/v1/masks/front.schema.json"
}