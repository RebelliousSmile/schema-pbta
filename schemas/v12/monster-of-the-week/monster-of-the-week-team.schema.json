  "additionalProperties": false,
  "title": "Monster of the Week team",
  "description": "Portable representation of a Monster of the Week team playbook.",
  "$id": "https://raw.githubusercontent.com/RebelliousSmile/schema-pbta/v12.0.0/schemas/v12/monster-of-the-week/monster-of-the-week-team.schema.json"
}