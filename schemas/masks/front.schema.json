{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "concept": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "stakes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "threats": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "impulse": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "moves": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    }
                  },
                  "required": [
                    "ref"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "moveType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "playbook": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "trigger": {
                      "type": "string",
                      "minLength": 1
                    },
                    "roll": {
                      "type": "object",
                      "properties": {
                        "rollType": {
                          "type": "string",
                          "minLength": 1
                        },
                        "rollFormula": {
                          "type": "string",
                          "minLength": 1
                        },
                        "rollMod": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "rollType"
                      ],
                      "additionalProperties": false
                    },
                    "results": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "label",
                          "text"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "uses": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "choices": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "name",
                    "moveType",
                    "description"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "clock": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "preset": {
                    "type": "string",
                    "minLength": 1
                  },
                  "filled": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "label",
                  "preset"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "segments": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "filled": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "label",
                  "segments"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "name",
          "type",
          "impulse",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "portents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "doom": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "slug",
    "name",
    "game",
    "concept",
    "threats",
    "doom"
  ],
  "additionalProperties": false
}