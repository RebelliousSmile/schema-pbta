{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case identifier of the playbook."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable playbook name."
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Folder slug of the game this playbook belongs to."
    },
    "actorType": {
      "description": "Character sheet type driven by this playbook.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Plain-text explanation of the playbook."
    },
    "playbookImage": {
      "description": "Image reference associated with the playbook.",
      "type": "string",
      "minLength": 1
    },
    "stats": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "description": "Starting signed 32-bit stat values keyed by game stat."
    },
    "statsDetail": {
      "description": "Text accompanying the starting stat spread.",
      "type": "string",
      "minLength": 1
    },
    "statProfiles": {
      "description": "Named starting-stat profiles offered during character creation.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable key identifying this starting-stat profile."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable name of this starting-stat profile."
          },
          "stats": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "description": "Signed starting values keyed by game stat."
          }
        },
        "required": [
          "key",
          "label",
          "stats"
        ],
        "additionalProperties": false,
        "description": "A named stat profile available during character creation."
      }
    },
    "attributes": {
      "description": "Starting values keyed by game attribute.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "moves": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "description": "Slug of a standalone move in the same game."
              },
              "checked": {
                "description": "Whether this move is currently acquired.",
                "type": "boolean"
              }
            },
            "required": [
              "ref"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable move name."
              },
              "moveType": {
                "type": "string",
                "minLength": 1,
                "description": "Key declared in the game's move type vocabulary."
              },
              "audience": {
                "description": "Optional audience that owns this move; MC moves use `mc`.",
                "type": "string",
                "enum": [
                  "character",
                  "npc",
                  "mc"
                ]
              },
              "playbook": {
                "description": "Playbook slug when the move belongs to one.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "Plain-text explanation of the move."
              },
              "trigger": {
                "description": "Situation that triggers the move.",
                "type": "string",
                "minLength": 1
              },
              "roll": {
                "description": "Optional roll configuration.",
                "type": "object",
                "properties": {
                  "rollType": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Game stat key, `formula`, or `none` describing how the move rolls."
                  },
                  "rollFormula": {
                    "description": "Explicit roll formula when rollType is `formula`.",
                    "type": "string",
                    "minLength": 1
                  },
                  "rollMod": {
                    "description": "Signed 32-bit modifier added to the roll.",
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  }
                },
                "required": [
                  "rollType"
                ],
                "additionalProperties": false
              },
              "results": {
                "description": "Outcome entries keyed by the game's roll result vocabulary.",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Human-readable label for this result tier."
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Plain-text outcome for this result tier."
                    }
                  },
                  "required": [
                    "label",
                    "text"
                  ],
                  "additionalProperties": false,
                  "description": "One possible outcome of a move roll."
                }
              },
              "uses": {
                "description": "Available uses, stored as an unsigned 32-bit count.",
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "choices": {
                "description": "Choice instructions attached to the move.",
                "type": "string",
                "minLength": 1
              },
              "tags": {
                "description": "Free-form tags attached to the move.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "checked": {
                "description": "Whether this move is currently acquired.",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "moveType",
              "description"
            ],
            "additionalProperties": false
          }
        ],
        "description": "A move carried by this playbook, with its optional acquisition state."
      },
      "description": "Moves available to this playbook."
    },
    "startingMoves": {
      "description": "Slugs of moves granted at character creation.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "choiceSets": {
      "description": "Move choices available during creation or advancement.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable heading for the choice set."
          },
          "description": {
            "description": "Explanation shown with the choices.",
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multi"
            ],
            "description": "Whether one or several choices may be selected."
          },
          "repeatable": {
            "description": "Whether this choice set can be granted more than once.",
            "type": "boolean"
          },
          "grantOn": {
            "description": "Lifecycle event that grants this choice set.",
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                      "description": "Slug of a standalone move in the same game."
                    },
                    "granted": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647,
                      "description": "Number of times this choice is granted."
                    },
                    "advancement": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647,
                      "description": "Advancement step at which this choice becomes available."
                    }
                  },
                  "required": [
                    "ref",
                    "granted",
                    "advancement"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Human-readable move name."
                    },
                    "moveType": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Key declared in the game's move type vocabulary."
                    },
                    "audience": {
                      "description": "Optional audience that owns this move; MC moves use `mc`.",
                      "type": "string",
                      "enum": [
                        "character",
                        "npc",
                        "mc"
                      ]
                    },
                    "playbook": {
                      "description": "Playbook slug when the move belongs to one.",
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Plain-text explanation of the move."
                    },
                    "trigger": {
                      "description": "Situation that triggers the move.",
                      "type": "string",
                      "minLength": 1
                    },
                    "roll": {
                      "description": "Optional roll configuration.",
                      "type": "object",
                      "properties": {
                        "rollType": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Game stat key, `formula`, or `none` describing how the move rolls."
                        },
                        "rollFormula": {
                          "description": "Explicit roll formula when rollType is `formula`.",
                          "type": "string",
                          "minLength": 1
                        },
                        "rollMod": {
                          "description": "Signed 32-bit modifier added to the roll.",
                          "type": "integer",
                          "minimum": -2147483648,
                          "maximum": 2147483647
                        }
                      },
                      "required": [
                        "rollType"
                      ],
                      "additionalProperties": false
                    },
                    "results": {
                      "description": "Outcome entries keyed by the game's roll result vocabulary.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Human-readable label for this result tier."
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Plain-text outcome for this result tier."
                          }
                        },
                        "required": [
                          "label",
                          "text"
                        ],
                        "additionalProperties": false,
                        "description": "One possible outcome of a move roll."
                      }
                    },
                    "uses": {
                      "description": "Available uses, stored as an unsigned 32-bit count.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "choices": {
                      "description": "Choice instructions attached to the move.",
                      "type": "string",
                      "minLength": 1
                    },
                    "tags": {
                      "description": "Free-form tags attached to the move.",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "granted": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647,
                      "description": "Number of times this choice is granted."
                    },
                    "advancement": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647,
                      "description": "Advancement step at which this choice becomes available."
                    }
                  },
                  "required": [
                    "name",
                    "moveType",
                    "description",
                    "granted",
                    "advancement"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Moves offered by this choice set."
          }
        },
        "required": [
          "title",
          "type",
          "choices"
        ],
        "additionalProperties": false,
        "description": "A group of moves from which the player chooses."
      }
    },
    "advancement": {
      "description": "Advancement options offered by the playbook.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable advancement option."
          },
          "checked": {
            "description": "Whether this advancement has been acquired.",
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "description": "One advancement option and its optional acquisition state."
      }
    },
    "creation": {
      "description": "Questions asked during character creation.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Question or prompt shown during character creation."
          },
          "options": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Stable value persisted when this option is selected."
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Human-readable label shown for this option."
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false,
                  "description": "Creation option with a stable persisted value and display label."
                }
              ]
            },
            "description": "Non-empty list of answers offered to the player."
          },
          "selection": {
            "description": "Selection bounds; omitted questions select exactly one answer.",
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647,
                "description": "Minimum number of options selected during creation."
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647,
                "description": "Maximum number of options selected during creation."
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          "attribute": {
            "description": "Character attribute initialized by the selection; it remains freely editable afterwards.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "label",
          "options"
        ],
        "additionalProperties": false,
        "description": "One character-creation question, its answers, cardinality, and optional attribute destination."
      }
    },
    "gear": {
      "description": "Starting or selectable gear.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable gear name."
          },
          "equipmentType": {
            "description": "Key declared in the game's equipment type vocabulary.",
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "Plain-text explanation of the gear.",
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "description": "Quantity held, stored as an unsigned 32-bit count.",
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "tags": {
            "description": "Free-form tags attached to the gear.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "description": "A piece of starting or selectable gear."
      }
    },
    "luck": {
      "description": "Starting Luck marks.",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "ratings": {
      "description": "Playbook resources keyed by their rating name.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    "improvements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable advancement option."
          },
          "checked": {
            "description": "Whether this advancement has been acquired.",
            "type": "boolean"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false,
        "description": "One advancement option and its optional acquisition state."
      },
      "description": "Improvements offered by the playbook."
    },
    "editorial": {
      "type": "object",
      "properties": {
        "opening": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 1,
              "description": "Heading shown for this playbook section."
            },
            "paragraphs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Ordered plain-text paragraphs shown in this section."
            }
          },
          "required": [
            "heading",
            "paragraphs"
          ],
          "additionalProperties": false,
          "description": "Opening fiction for the playbook."
        },
        "playAdvice": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 1,
              "description": "Heading shown for this playbook section."
            },
            "paragraphs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Ordered plain-text paragraphs shown in this section."
            }
          },
          "required": [
            "heading",
            "paragraphs"
          ],
          "additionalProperties": false,
          "description": "Advice for playing the character."
        },
        "identity": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 1,
              "description": "Heading shown for this playbook section."
            },
            "paragraphs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Ordered plain-text paragraphs shown in this section."
            }
          },
          "required": [
            "heading",
            "paragraphs"
          ],
          "additionalProperties": false,
          "description": "Identity choices and descriptive prompts."
        },
        "progression": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string",
              "minLength": 1,
              "description": "Heading shown for this playbook section."
            },
            "paragraphs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Ordered plain-text paragraphs shown in this section."
            }
          },
          "required": [
            "heading",
            "paragraphs"
          ],
          "additionalProperties": false,
          "description": "Advancement and continuation guidance."
        }
      },
      "required": [
        "opening",
        "playAdvice",
        "identity",
        "progression"
      ],
      "additionalProperties": false,
      "description": "Complete editorial copy rendered with the playbook."
    }
  },
  "required": [
    "slug",
    "name",
    "game",
    "description",
    "stats",
    "moves",
    "improvements",
    "editorial"
  ],
  "additionalProperties": false,
  "title": "Monster of the Week playbook",
  "description": "Portable single-document representation of a Monster of the Week playbook.",
  "$id": "https://raw.githubusercontent.com/RebelliousSmile/schema-pbta/v5.0.0/schemas/v5/monster-of-the-week/monster-of-the-week-playbook.schema.json"
}