{
  "manifestVersion": 1,
  "version": "0.3.0",
  "minimumHandbookVersion": "2.8.0",
  "requires": [
    "block:pbta-playbook",
    "block:pbta-move",
    "style:pbta",
    "block:sprawl-matrix",
    "block:sprawl-mission",
    "block:sprawl-card"
  ],
  "pack": {
    "id": "the-sprawl",
    "label": "The Sprawl",
    "style": {
      "base": {
        "note": {
          "--font-text-theme": "'Exo 2', 'Segoe UI', sans-serif",
          "--font-header-theme": "'Jura', 'Arial Narrow', sans-serif",
          "--h1-font": "'Michroma', 'Eurostile', 'Arial', sans-serif",
          "--h2-font": "'Jura', 'Arial Narrow', sans-serif",
          "--h1-text-transform": "uppercase",
          "--h2-text-transform": "none",
          "--font-text-size": "16px",
          "--inline-title-font": "'Michroma', 'Eurostile', 'Arial', sans-serif",
          "--inline-title-weight": "400",
          "--inline-title-text-transform": "uppercase",
          "--h1-size": "2.1em",
          "--h1-weight": "400",
          "--h1-line-height": "1.05",
          "--h2-size": "1.5em",
          "--h2-weight": "400",
          "--h2-line-height": "1.1",
          "--h3-font": "'Jura', 'Arial Narrow', sans-serif",
          "--h3-size": "1.2em",
          "--h3-weight": "400",
          "--h3-text-transform": "none",
          "--h4-font": "'Jura', 'Arial Narrow', sans-serif",
          "--h4-weight": "700",
          "--the-sprawl-title-font": "'Michroma', 'Eurostile', 'Arial', sans-serif",
          "--the-sprawl-heading-font": "'Jura', 'Arial Narrow', sans-serif",
          "--the-sprawl-body-font": "'Exo 2', 'Segoe UI', sans-serif",
          "--pbta-column-gap": "1.75rem",
          "--list-marker-color": "#1b2a49",
          "--hr-color": "#9aa5b8",
          "--hr-thickness": "3px"
        }
      },
      "light": {
        "note": {
          "--background-primary": "#ffffff",
          "--background-primary-alt": "#f2f4f8",
          "--text-normal": "#141c2e",
          "--text-muted": "#55607a",
          "--color-accent": "#1b2a49",
          "--interactive-accent": "#1b2a49",
          "--link-color": "#2a8db5",
          "--link-color-hover": "#1b2a49",
          "--h1-color": "#1b2a49",
          "--h2-color": "#1b2a49",
          "--tag-color": "#ffffff",
          "--tag-background": "#1b2a49",
          "--checkbox-color": "#2a8db5",
          "--code-normal": "#141c2e",
          "--code-background": "#f2f4f8",
          "--the-sprawl-accent": "#1b2a49",
          "--the-sprawl-accent-alt": "#2a8db5",
          "--the-sprawl-ink": "#141c2e",
          "--the-sprawl-on-ink": "#ffffff",
          "--the-sprawl-panel": "#f2f4f8",
          "--the-sprawl-rule": "#9aa5b8"
        }
      }
    },
    "polarities": [
      "light"
    ],
    "assets": {
      "stylesheets": [
        "styles/callouts.css",
        "styles/page.css",
        "styles/layout.css",
        "styles/headings.css"
      ],
      "images": {
        "game-mark": "images/network-grid.svg"
      },
      "fonts": {
        "Michroma": {
          "file": "fonts/michroma-400-normal.woff2",
          "weight": "400",
          "style": "normal"
        },
        "Jura": {
          "file": "fonts/jura-wght-normal.woff2",
          "weight": "300 700",
          "style": "normal"
        },
        "Exo 2": {
          "file": "fonts/exo-2-wght-normal.woff2",
          "weight": "100 900",
          "style": "normal"
        },
        "Exo 2 Italic": {
          "file": "fonts/exo-2-wght-italic.woff2",
          "weight": "100 900",
          "style": "italic"
        }
      }
    }
  }
}
