{
  "manifestVersion": 1,
  "version": "0.3.0",
  "minimumHandbookVersion": "2.8.0",
  "requires": ["block:pbta-playbook", "block:pbta-move", "style:pbta"],
  "pack": {
    "id": "the-sprawl",
    "label": "The Sprawl",
    "style": {
      "base": {
        "note": {
          "--font-text-theme": "Arial, sans-serif",
          "--font-header-theme": "Arial Narrow, Roboto Condensed, sans-serif",
          "--h1-font": "Arial Narrow, Roboto Condensed, sans-serif",
          "--h2-font": "Arial Narrow, Roboto Condensed, sans-serif",
          "--h1-text-transform": "uppercase",
          "--h2-text-transform": "uppercase"
        }
      },
      "light": {
        "note": {
          "--background-primary": "#ffffff",
          "--background-primary-alt": "#eef7f6",
          "--text-normal": "#12262b",
          "--text-muted": "#4a6a6c",
          "--color-accent": "#c4155f",
          "--interactive-accent": "#c4155f",
          "--link-color": "#00776c",
          "--link-color-hover": "#c4155f",
          "--h1-color": "#c4155f",
          "--h2-color": "#00776c",
          "--tag-color": "#ffffff",
          "--tag-background": "#12373a",
          "--checkbox-color": "#00776c"
        }
      }
    },
    "polarities": ["light"],
    "assets": {
      "stylesheets": ["styles/callouts.css"],
      "images": {
        "game-mark": "images/network-grid.svg"
      }
    }
  }
}
