{
  "manifestVersion": 1,
  "version": "0.4.0",
  "minimumHandbookVersion": "2.8.0",
  "requires": ["block:pbta-playbook", "block:pbta-move", "style:pbta"],
  "pack": {
    "id": "monsterhearts",
    "label": "Monsterhearts",
    "style": {
      "base": {
        "note": {
          "--font-text-theme": "'Alice', Georgia, serif",
          "--font-header-theme": "'Alice', Georgia, serif",
          "--font-text-size": "16px",
          "--line-height-normal": "1.2",
          "--file-line-width": "72rem",
          "--p-spacing": "0.56rem",
          "--inline-title-font": "'Yellow Magician', Garamond, Georgia, serif",
          "--inline-title-text-transform": "uppercase",
          "--inline-title-weight": "400",
          "--inline-title-line-height": "1.04",
          "--h1-font": "'Yellow Magician', Garamond, Georgia, serif",
          "--h1-size": "2.15em",
          "--h1-weight": "400",
          "--h1-line-height": "1.04",
          "--h1-text-transform": "uppercase",
          "--h2-font": "'El Messiri', 'Alice', Georgia, serif",
          "--h2-size": "1.48em",
          "--h2-weight": "400",
          "--h2-line-height": "1.06",
          "--h3-font": "'El Messiri', 'Alice', Georgia, serif",
          "--h3-size": "1.25em",
          "--h3-weight": "400",
          "--h3-line-height": "1.08",
          "--pbta-column-gap": "2.4rem",
          "--pbta-column-rule": "#292326",
          "--monsterhearts-title-font": "'Yellow Magician', 'Averia Serif Libre', Garamond, Georgia, serif",
          "--monsterhearts-script-font": "'Fondamento', cursive",
          "--monsterhearts-title-ink": "#292326",
          "--monsterhearts-table-ink": "#171416",
          "--monsterhearts-table-background": "#ffffff",
          "--monsterhearts-table-rule": "#292326",
          "--monsterhearts-table-header": "#e5e3e1",
          "--monsterhearts-table-header-ink": "#171416",
          "--bold-color": "#171416",
          "--italic-color": "#4f343d",
          "--blockquote-border-color": "#292326",
          "--blockquote-color": "#292326",
          "--blockquote-background-color": "transparent",
          "--list-marker-color": "#292326",
          "--list-marker-color-hover": "#171416",
          "--hr-color": "#292326",
          "--hr-thickness": "1px"
        }
      },
      "light": {
        "note": {
          "--background-primary": "#ffffff",
          "--background-primary-alt": "#f3f4f5",
          "--text-normal": "#171416",
          "--text-muted": "#5f5758",
          "--color-accent": "#292326",
          "--interactive-accent": "#292326",
          "--link-color": "#643f4b",
          "--link-color-hover": "#171416",
          "--h1-color": "#292326",
          "--h2-color": "#171416",
          "--h3-color": "#171416",
          "--tag-color": "#ffffff",
          "--tag-background": "#292326",
          "--checkbox-color": "#292326"
        }
      }
    },
    "polarities": ["light"],
    "assets": {
      "fonts": {
        "Yellow Magician": {
          "file": "fonts/yellow-magician-latin-400-normal.woff2",
          "weight": "400",
          "style": "normal"
        },
        "El Messiri": {
          "file": "fonts/el-messiri-latin-400-700-normal.woff2",
          "weight": "400",
          "style": "normal"
        },
        "Averia Serif Libre": {
          "file": "fonts/averia-serif-libre-latin-700-normal.woff2",
          "weight": "700",
          "style": "normal"
        },
        "Alice": {
          "file": "fonts/alice-latin-400-normal.woff2",
          "weight": "400",
          "style": "normal"
        },
        "Fondamento": {
          "file": "fonts/fondamento-latin-400-normal.woff2",
          "weight": "400",
          "style": "normal"
        }
      },
      "stylesheets": ["styles/callouts.css"],
      "images": {
        "game-mark": "images/thorn-heart.svg"
      }
    }
  }
}
