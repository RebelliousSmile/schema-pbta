{
  "name": "schema-pbta",
  "version": "0.1.0",
  "description": "Open, versioned data schemas for Powered by the Apocalypse games, to make digital tools interoperable.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && npm run gen",
    "gen": "tsx tools/gen-schemas.ts",
    "validate": "tsx tools/validate-examples.ts",
    "validate:refs": "tsx tools/validate-references.ts",
    "validate:refs:fixtures": "tsx tools/validate-reference-fixtures.ts",
    "audit": "tsx tools/audit-schemas.ts",
    "handbook:validate": "tsx tools/validate-handbook-packs.ts",
    "handbook:validate:fixtures": "tsx tools/validate-handbook-catalog-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run gen && npm run validate && npm run validate:contract && npm run validate:refs && npm run validate:refs:fixtures && npm run audit && npm run validate:package && npm run handbook:render && npm run handbook:validate && npm run handbook:validate:fixtures",
    "validate:contract": "tsx tools/validate-contract.ts",
    "validate:package": "tsx tools/validate-package.ts",
    "toml:one": "tsx tools/toml2json.ts",
    "handbook:render": "tsx tools/render-handbook-preview.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RebelliousSmile/schema-pbta.git"
  },
  "keywords": [
    "Powered by the Apocalypse",
    "PbtA",
    "Schema",
    "Interoperable"
  ],
  "author": "RebelliousSmile",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RebelliousSmile/schema-pbta/issues"
  },
  "homepage": "https://github.com/RebelliousSmile/schema-pbta#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/v1/*": "./schemas/v1/*",
    "./schemas/*": "./schemas/v1/*",
    "./corpus/*": "./corpus/contract/*"
  },
  "files": [
    "dist",
    "schemas/v1",
    "corpus/contract",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "smol-toml": "^1.8.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^24.5.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
