{
  "name": "schema-pbta",
  "version": "8.1.2",
  "description": "Open, versioned data schemas for Powered by the Apocalypse games, to make digital tools interoperable.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && npm run gen",
    "gen": "tsx tools/gen-schemas.ts && tsx tools/gen-presentation-contracts.ts",
    "validate": "tsx tools/validate-examples.ts",
    "validate:refs": "tsx tools/validate-references.ts",
    "validate:refs:fixtures": "tsx tools/validate-reference-fixtures.ts",
    "audit": "tsx tools/audit-schemas.ts",
    "handbook:validate": "tsx tools/validate-handbook-packs.ts",
    "handbook:validate:fixtures": "tsx tools/validate-handbook-catalog-fixtures.ts",
    "handbook:validate:install": "tsx tools/validate-handbook-install.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run gen && npm run validate && npm run validate:contract && npm run validate:refs && npm run validate:refs:fixtures && npm run audit && npm run validate:version && npm run validate:package && npm run validate:release && npm run handbook:render && npm run handbook:validate && npm run handbook:validate:fixtures && npm run handbook:validate:install && npm run validate:pack -- packs/monsterhearts/pack-contract.json && npm run validate:packs && npm run validate:cross-tool:provider && npm run validate:cross-tool:pins",
    "validate:contract": "tsx tools/validate-contract.ts && npm run validate:presentation",
    "validate:pack": "tsx tools/validate-pack-manifest.ts",
    "validate:packs": "tsx tools/validate-packs.ts && tsx tools/validate-pack-coverage.ts",
    "validate:cross-tool": "tsx tools/validate-cross-tool-contract.ts",
    "validate:cross-tool:pins": "tsx tools/validate-cross-tool-pins.ts",
    "validate:cross-tool:provider": "tsx tools/validate-cross-tool-provider.ts",
    "create:pack": "tsx tools/create-pack.ts",
    "validate:presentation": "tsx tools/validate-presentation-contract.ts",
    "validate:package": "tsx tools/validate-package.ts",
    "validate:release": "tsx tools/prepare-release.ts --verify",
    "validate:version": "tsx tools/validate-version-compat.ts",
    "release:prepare": "tsx tools/prepare-release.ts",
    "toml:one": "tsx tools/toml2json.ts",
    "handbook:render": "tsx tools/render-handbook-preview.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RebelliousSmile/schema-pbta.git"
  },
  "keywords": [
    "Powered by the Apocalypse",
    "PbtA",
    "Schema",
    "Interoperable"
  ],
  "author": "RebelliousSmile",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RebelliousSmile/schema-pbta/issues"
  },
  "homepage": "https://github.com/RebelliousSmile/schema-pbta#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/v1/*": "./schemas/v1/*",
    "./schemas/v2/*": "./schemas/v2/*",
    "./schemas/v3/*": "./schemas/v3/*",
    "./schemas/v4/*": "./schemas/v4/*",
    "./schemas/v5/*": "./schemas/v5/*",
    "./schemas/v6/*": "./schemas/v6/*",
    "./schemas/v7/*": "./schemas/v7/*",
    "./schemas/v8/*": "./schemas/v8/*",
    "./corpus/presentation/*": "./corpus/presentation/*",
    "./corpus/*": "./corpus/contract/*",
    "./packs/*": "./packs/*",
    "./cross-tool-provider.json": "./cross-tool-provider.json"
  },
  "files": [
    "dist",
    "schemas/v1",
    "schemas/v2",
    "schemas/v3",
    "schemas/v4",
    "schemas/v5",
    "schemas/v6",
    "schemas/v7",
    "schemas/v8",
    "corpus/contract",
    "corpus/presentation",
    "packs",
    "cross-tool-provider.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "smol-toml": "^1.8.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^24.5.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
