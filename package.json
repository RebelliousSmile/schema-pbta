{
  "name": "schema-pbta",
  "version": "0.0.1",
  "description": "Open, versioned data schemas for Powered by the Apocalypse games, to make digital tools interoperable.",
  "scripts": {
    "gen": "tsx tools/gen-schemas.ts",
    "validate": "tsx tools/validate-examples.ts",
    "validate:refs": "tsx tools/validate-references.ts",
    "validate:refs:fixtures": "tsx tools/validate-reference-fixtures.ts",
    "audit": "tsx tools/audit-schemas.ts",
    "handbook:validate": "tsx tools/validate-handbook-packs.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run gen && npm run validate && npm run validate:refs && npm run validate:refs:fixtures && npm run audit && npm run handbook:render && npm run handbook:validate",
    "toml:one": "tsx tools/toml2json.ts",
    "handbook:render": "tsx tools/render-handbook-preview.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RebelliousSmile/schema-pbta.git"
  },
  "keywords": [
    "Powered by the Apocalypse",
    "PbtA",
    "Schema",
    "Interoperable"
  ],
  "author": "RebelliousSmile",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RebelliousSmile/schema-pbta/issues"
  },
  "homepage": "https://github.com/RebelliousSmile/schema-pbta#readme",
  "type": "module",
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/node": "^24.5.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^4.1.11"
  }
}
